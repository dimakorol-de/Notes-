<template>
  <div class="container">
    <!-- ЗОНА ВВОДА И СИСТЕМНЫХ ДЕЙСТВИЙ -->
    <div class="display-section">
      <text class="input-viewer">{{ currentInput || "Введите текст..." }}</text>
      <div class="actions-row">
        <input type="button" class="ctrl-btn btn-reset" value="Сброс" onclick="clearInput" />
        <input type="button" class="ctrl-btn btn-save" value="Сохранить" onclick="saveData" />
      </div>
    </div>

    <!-- СЕТКА КЛАВИАТУРЫ ЙЦУКЕН (Полностью на CSS, без картинок) -->
    <div class="keyboard-grid">
      <block for="{{ row in ruLayout[activePage] }}">
        <div class="keyboard-row">
          <block for="{{ char in row }}">
            
            <!-- Кнопка Пробела -->
            <input if="{{ char === 'SPACE' }}" type="button" class="key-btn size-space" value="Пробел" onclick="typeLetter(' ')" />

            <!-- Кнопка Backspace (Удаление буквы) -->
            <input if="{{ char === 'DEL' }}" type="button" class="key-btn size-std key-special" value="←" onclick="triggerBackspace" />

            <!-- Смена страницы 1/2 и 2/2 -->
            <input if="{{ char === 'PAGE' }}" type="button" class="key-btn size-std key-special" value="{{ activePage === 0 ? '1/2' : '2/2' }}" onclick="changePage" />
            
            <!-- Обычная русская буква -->
            <input else type="button" class="key-btn size-std" value="{{ char }}" onclick="typeLetter(char)" />

          </block>
        </div>
      </block>
    </div>

    <!-- ПРОКРУЧИВАЕМЫЙ СПИСОК (ЗОНА ДЛЯ МОТАНИЯ ЗАМЕТОК) -->
    <!-- Тег list включает плавный вертикальный скроллинг на Mi Band 10 -->
    <list class="notes-scroller">
      <list-item type="item-node" class="note-row-card" for="{{ (index, text) in notesDb }}">
        <text class="note-display-text">{{ text }}</text>
        
        <!-- Кнопка удаления записи (Текстовый крестик вместо картинки) -->
        <input type="button" class="btn-delete-node" value="✕" onclick="deleteNote(index)" />
      </list-item>
    </list>
  </div>
</template>

<script>
import storage from '@system.storage'; // Импорт системного хранилища

export default {
  private: {
    currentInput: "", 
    activePage: 0,    
    notesDb: [],      

    // Русские буквы распределены под ширину экрана Mi Band 10 (212px)
    ruLayout: [
      [
        ["Й", "Ц", "У", "К", "Е"],
        ["Н", "Г", "Ш", "Щ", "З"],
        ["Ф", "Ы", "В", "А", "П"],
        ["PAGE", "SPACE", "DEL"]
      ],
      [
        ["Р", "О", "Л", "Д", "Ж"],
        ["Э", "Х", "Ъ", "Я", "Ч"],
        ["С", "М", "И", "Т", "Ь"],
        ["Б", "Ю", "Ё", ".", "DEL"]
      ]
    ]
  },

  onInit() {
    this.loadNotes();
  },

  typeLetter(char) {
    this.currentInput += char;
  },

  triggerBackspace() {
    if (this.currentInput.length > 0) {
      this.currentInput = this.currentInput.slice(0, -1);
    }
  },

  clearInput() {
    this.currentInput = "";
  },

  changePage() {
    this.activePage = this.activePage === 0 ? 1 : 0;
  },

  saveData() {
    const textValue = this.currentInput.trim();
    if (!textValue) return;

    this.notesDb.push(textValue);
    this.saveNotes();
    this.currentInput = ""; 
  },

  // Функция удаления сохраненного текста из списка по индексу
  deleteNote(index) {
    this.notesDb.splice(index, 1); 
    this.saveNotes(); 
  },

  loadNotes() {
    const self = this;
    storage.get({ // Чтение из постоянной памяти
      key: 'user_saved_notes_data',
      success: function(data) {
        if (data) {
          self.notesDb = JSON.parse(data);
        }
      }
    });
  },

  saveNotes() {
    storage.set({ // Запись в постоянную память
      key: 'user_saved_notes_data',
      value: JSON.stringify(this.notesDb)
    });
  }
}
</script>

<style>
  .container {
    flex-direction: column;
    background-color: #000000;
    width: 212px; /* Фиксированная ширина под капсулу Mi Band 10 */
    height: 100%;
  }
  .display-section {
    flex-direction: column;
    padding: 6px;
    background-color: #080808;
    width: 212px;
  }
  .input-viewer {
    color: #ffffff;
    font-size: 20px;
    text-align: center;
    margin-bottom: 4px;
  }
  .actions-row {
    justify-content: space-between;
    width: 100%;
  }
  .ctrl-btn {
    width: 95px;
    height: 28px;
    font-size: 13px;
    color: #ffffff;
    border-radius: 5px;
  }
  .btn-reset { background-color: #a81515; }
  .btn-save { background-color: #15822e; }

  /* Клавиатура */
  .keyboard-grid {
    flex-direction: column;
    padding: 2px;
    width: 212px;
  }
  .keyboard-row {
    justify-content: center;
    margin-bottom: 2px;
  }
  .key-btn {
    background-color: #222222;
    color: #ffffff;
    font-size: 18px;
    font-weight: bold;
    border-radius: 6px;
    margin: 1px;
    border: 1px solid #333333;
  }
  .size-std { width: 38px; height: 38px; }
  .size-space { width: 80px; height: 38px; font-size: 14px; }
  
  .key-special {
    background-color: #2c3e50;
    color: #007aff;
  }

  /* Нативный скроллинг сохраненных записей под Mi Band 10 */
  .notes-scroller {
    width: 212px;
    height: 190px;
    margin-top: 4px;
  }
  .note-row-card {
    width: 212px;
    padding: 8px;
    background-color: #111111;
    border-bottom: 1px solid #1f1f1f;
    justify-content: space-between;
    align-items: center;
  }
  .note-display-text {
    color: #e0e0e0;
    font-size: 15px;
    flex: 1;
  }
  .btn-delete-node {
    width: 24px;
    height: 24px;
    background-color: #310c0c;
    color: #ff4d4d;
    font-size: 14px;
    border-radius: 12px;
    border: none;
  }
</style>
